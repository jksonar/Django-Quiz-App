# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real credentials.
#
# --- Gmail SMTP setup ---
# 1. Turn on 2-Step Verification on the Gmail account you want to send from:
#    https://myaccount.google.com/security
# 2. Create an App Password (Gmail will not accept your normal account
#    password for SMTP): https://myaccount.google.com/apppasswords
#    Select app "Mail", device "Other", name it e.g. "Django Quiz App".
#    Google shows you a 16-character password - use it below (spaces don't
#    matter, e.g. "abcd efgh ijkl mnop" or "abcdefghijklmnop" both work).
# 3. Fill in EMAIL_HOST_USER with the full Gmail address, and
#    EMAIL_HOST_PASSWORD with that app password.
#
# Leave EMAIL_HOST_USER blank (or delete this file) to keep using the console
# backend, which just prints emails to the terminal - no real email is sent.

EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=your16charapppassword
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Shown as the "From" address. Gmail SMTP generally requires this to match
# EMAIL_HOST_USER (or an alias on that account), so leave it unset to default
# to EMAIL_HOST_USER.
# DEFAULT_FROM_EMAIL=youraddress@gmail.com

# Base URL used to build links in emails sent outside a request context
# (the send_quiz_reminders management command). Change this once you deploy
# somewhere other than localhost.
SITE_URL=http://127.0.0.1:8000
